{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8089",
    "ANTHROPIC_AUTH_TOKEN": "proxy-local-token",
    "ANTHROPIC_MODEL": "xai.grok-4.3-thinking-high[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "xai.grok-4.3-thinking-high[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "xai.grok-4.3-thinking-high[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "xai.grok-4.3-thinking-none[1m]",
    "ANTHROPIC_SMALL_FAST_MODEL": "xai.grok-4.3-thinking-none[1m]",
    "CLAUDE_CODE_SUBAGENT_MODEL": "xai.grok-4.3-thinking-high[1m]",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "DISABLE_INTERLEAVED_THINKING": "0",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "88",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "MCP_TIMEOUT": "200000",
    "ENABLE_TOOL_SEARCH": "auto",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "API_TIMEOUT_MS": "6000000",
    "CLAUDE_ENABLE_STREAM_WATCHDOG": "0",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-hook.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "if [ -f 'C:/Users/Mahes/.orca/agent-hooks/claude-statusline.cmd' ]; then 'C:/Users/Mahes/.orca/agent-hooks/claude-statusline.cmd'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi"
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true
}
