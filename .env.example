# Copy this file to .env and fill in ONE of the two credential styles.
# Values are read literally - do not URL-encode them. A Bedrock API key is
# base64 and may contain '+' or '/' and end with '=='; paste it exactly as AWS
# gave it to you. Quotes are optional.

# --- Option A: Bedrock API key (simplest, no signing) ---------------------
# Console: Bedrock > API keys. Long-term keys start with ABSK, short-term
# keys start with bedrock-api-key- and expire within 12 hours.
BEDROCK_API_KEY=

# --- Option B: access key + secret key (SigV4, signed in-process) ---------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_REGION=us-east-1
# Optional: point the Mantle endpoint at a different region from Converse.
# Grok 4.3 is served from us-west-2 only.
# MANTLE_REGION=us-west-2

# --- Optional ------------------------------------------------------------
# PROXY_API_KEY=sk-pick-your-own-instead-of-a-generated-one
# HOST=127.0.0.1
# PORT=8080
# CONFIG_PATH=data/config.json
# LOG_LEVEL=info
