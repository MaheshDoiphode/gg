# Copy this file to .env and fill in ONE of the two credential styles.
# Values are read literally - do not URL-encode them. A Bedrock API key is
# base64 and may contain '+' or '/' and end with '=='; paste it exactly as AWS
# gave it to you. Quotes are optional.

# --- Option A: Bedrock API key (simplest, no signing) ---------------------
# Console: Bedrock > API keys. Long-term keys start with ABSK, short-term
# keys start with bedrock-api-key- and expire within 12 hours.
BEDROCK_API_KEY=

# --- Option B: access key + secret key (SigV4, signed in-process) ---------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_REGION=us-east-1
# Mantle models are served from us-west-2; Grok 4.3 is only there and returns
# server_error in us-east-1.
MANTLE_REGION=us-west-2

# --- Optional ------------------------------------------------------------
# Kiro uses 8085 and something else holds 8080, so this proxy sits on 8089.
PROXY_API_KEY=sk-bedrock-simple-local
# This key is scoped to the Mantle endpoint and cannot call bedrock-runtime,
# so shared model names must resolve to Mantle.
PREFER_MANTLE=true
# VS Code does not send a literal apiKey from chatLanguageModels.json, and the
# proxy only listens on 127.0.0.1, so client auth is off.
REQUIRE_API_KEY=false
# HOST=127.0.0.1
PORT=8089
# CONFIG_PATH=data/config.json
# LOG_LEVEL=info
